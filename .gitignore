# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules

.DS_Store

# [ADDED] Keep a shareable template of env vars (the /.env* rule above would hide it)
!/.env.example

# [ADDED] Gems installed locally (bundle config set path vendor/bundle)
/vendor/bundle

# [ADDED] Local database dumps (we use Postgres, so no .sqlite3 needed)
*.dump
*.sql.gz

# [ADDED] Per-machine mise overrides (like the mise.local.toml we discussed)
mise.local.toml
.mise.local.toml

# [ADDED] Windows OS files (your teammate's machine)
Thumbs.db
Desktop.ini

# [ADDED] Editor files: ignore personal settings, keep shared project ones
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json