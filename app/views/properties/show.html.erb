<main class="container py-5">
  <div class="mb-4">
    <%= link_to "&larr; Back to Properties".html_safe, properties_path, class: "text-decoration-none text-secondary fw-semibold hover-accent" %>
  </div>

  <div class="row g-5">
    <div class="col-md-12">
      <h1 class="display-4 fw-bold"><%= @property.title %></h1>
      <p class="lead text-muted">
        <%= @property.address %> - 
        <% if @property.neighborhood %>
          <%= link_to @property.neighborhood.name, neighborhood_path(@property.neighborhood), class: "text-decoration-none accent-roomie" %>
        <% else %>
          <span class="text-muted">No neighborhood assigned</span>
        <% end %>
      </p>
      <% if @property.user == current_user || current_user.name.downcase.include?("mod") %>
        <div class="d-flex justify-content-center gap-3 mb-5">
          <%= link_to "Edit Property", edit_property_path(@property), class: "btn btn-outline-primary px-4 rounded-3" %>
          <%= link_to "Add New Room", new_property_listing_path(@property), class: "btn btn-mio px-4 rounded-3" %>
        </div>
      <% end %>
    </div>

    <div class="col-md-12 mt-4">
      <h3 class="fw-bold mb-4">Rooms in this Property</h3>
      <div class="row row-cols-1 row-cols-md-3 g-4">
        <% @property.listings.each do |listing| %>
          <div class="col">
            <%= render partial: "shared/listing_card", locals: { listing: listing } %>
          </div>
        <% end %>
      </div>
    </div>

    <hr class="my-5">
    <h3 class="fw-bold mb-4">Property Reviews</h3>

    <% if @property.reviews.any? %>
      <div class="row g-4 mb-5">
        <% @property.reviews.each do |review| %>
          <div class="col-md-6">
            <div class="card border-0 bg-light rounded-4 h-100 p-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <span class="fw-semibold"><%= review.user.name %></span>
                  <% if review.user == current_user || current_user.name.downcase.include?("mod") %>
                    <%= link_to "Edit", edit_review_path(review), class: "text-primary small fw-semibold text-decoration-none ms-3" %>
                    <span class="text-muted mx-1">|</span>
                    <%= link_to "Delete", review, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this review?" }, class: "text-danger small fw-semibold text-decoration-none" %>
                  <% end %>
                </div>
                <span class="text-warning">
                  <% review.rating.times do %><i class="bi bi-star-fill"></i><% end %>
                  <% (5 - review.rating).times do %><i class="bi bi-star"></i><% end %>
                </span>
              </div>
              <p class="text-muted small mb-0">"<%= review.comment %>"</p>
              <span class="text-muted" style="font-size: 0.75rem;"><%= review.created_at.strftime("%B %Y") %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted mb-5">No reviews yet for this property.</p>
    <% end %>

    <% current_user_visit = Visit.joins(application: :listing).find_by(status: "completed", applications: { seeker_id: current_user.id }, listings: { property_id: @property.id }) rescue nil %>
    
    <% if current_user_visit.present? && !Review.exists?(user_id: current_user.id, property_id: @property.id) %>
      <div class="card shadow-sm border-0 rounded-4 mb-5 bg-light">
        <div class="card-body p-4">
          <h5 class="fw-bold mb-3">Leave a Review</h5>
          <%= form_with model: Review.new, url: reviews_path, class: "row g-3" do |f| %>
            <%= f.hidden_field :property_id, value: @property.id %>
            <%= f.hidden_field :visit_id, value: current_user_visit.id %>
            
            <div class="col-md-3">
              <%= f.label :rating, "Rating (1-5)", class: "form-label fw-bold small text-muted" %>
              <%= f.number_field :rating, in: 1..5, class: "form-control border-0 bg-white", required: true %>
            </div>
            <div class="col-md-9">
              <%= f.label :comment, class: "form-label fw-bold small text-muted" %>
              <%= f.text_field :comment, class: "form-control border-0 bg-white", placeholder: "Share your experience about this property...", required: true %>
            </div>
            <div class="col-12 text-end mt-3">
              <%= f.submit "Submit Review", class: "btn btn-mio px-4 rounded-3" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</main>
