<%= form_with model: amenity, class: "card shadow-sm border-0 rounded-4 p-4" do |f| %>
  <div class="mb-4">
    <%= f.label :name, class: "form-label fw-bold small text-muted text-uppercase" %>
    <%= f.text_field :name, class: "form-control bg-light border-0 py-2", placeholder: "e.g., Gigabit WiFi" %>
  </div>
  <div class="d-flex justify-content-end gap-3 mt-2">
    <%= link_to "Cancel", amenities_path, class: "btn btn-light px-4 rounded-3" %>
    <%= f.submit class: "btn btn-mio px-5 rounded-3" %>
  </div>
<% end %>