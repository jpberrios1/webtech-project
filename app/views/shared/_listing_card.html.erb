<div class="card h-100 shadow-sm border">
  <% if listing.listing_photos.any? %>
    <img src="<%= listing.listing_photos.first.url %>" class="card-img-top img-room" alt="<%= listing.title %>" style="height: 200px; object-fit: cover;">
  <% else %>
    <div class="bg-secondary text-white d-flex align-items-center justify-content-center img-room" style="height: 200px;">No Image</div>
  <% end %>
  
  <div class="card-body">
    <h5 class="card-title"><%= listing.title %></h5>
    <p class="card-text text-truncate"><%= listing.description %></p>
  </div>
  
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><%= listing.neighborhood.name %> / <%= listing.neighborhood.city %></li>
    <li class="list-group-item">$<%= listing.monthly_rent %> / month</li>
    <li class="list-group-item">Available starting <%= listing.available_from.strftime("%B %dth, %Y") %></li>
  </ul>
  
  <div class="card-body">
    <%= link_to "See more", listing_path(listing), class: "card-link btn-mio" %>
  </div>
</div>