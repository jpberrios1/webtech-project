<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 text-center">
      <div class="card shadow-sm border-0 rounded-4 p-5 bg-light">
        <div class="mb-3 text-danger">
          <i class="bi bi-shield-lock-fill" style="font-size: 4rem;"></i>
        </div>
        <h1 class="display-6 fw-bold mb-3">Access Denied (403)</h1>
        <p class="lead text-muted mb-4">
          <%= @error_message || "You do not have permission to view this page or perform this action." %>
        </p>
        <div class="d-flex justify-content-center gap-3">
          <%= link_to "&larr; Go Back".html_safe, request.referer || root_path, class: "btn btn-outline-secondary px-4 rounded-3" %>
          <%= link_to "Back to Home", root_path, class: "btn btn-mio px-4 rounded-3" %>
        </div>
      </div>
    </div>
  </div>
</main>