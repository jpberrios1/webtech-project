<main class="hero-section">
  <h1 class="display-4 text-center mt-5">Split the rent and multiply the experiences with the perfect <span class="accent-roomie">Roomie</span>.</h1>
  <p class="lead text-center text-muted mt-3 mb-5">Find available rooms or list your spare space in a safe and trusted community.</p>

  <section class="search bg-white mx-auto py-4 px-3 px-sm-4">
    <form class="container bg-white p-3 p-md-4 rounded-4 shadow-sm border" style="max-width: 1000px;">
      <div class="row g-2 g-md-3 align-items-end">
        <div class="col-12 col-sm-6 col-lg-3">
          <label for="search" class="form-label small text-muted mb-1">Search</label>
          <input type="text" id="search" class="form-control border-0 bg-light" placeholder="Type to search...">
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
          <label for="city" class="form-label small text-muted mb-1">City</label>
          <select id="city" class="form-select border-0 bg-light">
            <option selected>All</option>
            <option value="las-condes">New York</option>
            <option value="providencia">Boston</option>
            <option value="santiago-centro">Florida</option>
          </select>
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
          <label for="budget" class="form-label small text-muted mb-1">Max budget</label>
          <div class="input-group">
            <span class="input-group-text border-0 bg-light text-muted">$</span>
            <input type="number" id="budget" class="form-control border-0 bg-light" placeholder="400">
          </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-2">
          <label for="date" class="form-label small text-muted mb-1">Date</label>
          <input type="date" id="date" class="form-control border-0 bg-light">
        </div>
        <div class="col-12 col-lg-2">
          <button type="submit" class="btn btn-mio w-100 py-2 rounded-3">Search</button>
        </div>
      </div>
    </form>
  </section>  
</main>

<section class="rooms container text-center py-5">
  <div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
    <% @featured_listings.each do |listing| %>
      <div class="col">
        <%= render partial: "shared/listing_card", locals: { listing: listing } %>
      </div>
    <% end %>
  </div>
</section>  

<section class="container text-center py-5">
  <h2 class="h2 text-uppercase fw-bold text-secondary mb-4 mt-5">How it works</h2>
  <div class="row row-cols-1 row-cols-md-3 g-3 bg-white shadow rounded-4 p-3">
    <div class="col">
      <div class="p-5 bg-light rounded-4">
        <span class="badge rounded-circle bg-mio fs-4 mb-3">1</span>
        <h3 class="h6 fw-bold">Publish or Search</h3>
        <p class="small text-muted mb-0">List your available room or browse listings by neighborhood and budget.</p>
      </div>
    </div>
    <div class="col">
      <div class="p-5 bg-light rounded-4 h-100">
        <span class="badge rounded-circle bg-mio fs-4 mb-3">2</span>
        <h3 class="h6 fw-bold">Apply Privately</h3>
        <p class="small text-muted mb-0">Send an introduction message with your move-in date and desired stay.</p>
      </div>
    </div>
    <div class="col">
      <div class="p-5 bg-light rounded-4 h-100">
        <span class="badge rounded-circle bg-mio fs-4 mb-3">3</span>
        <h3 class="h6 fw-bold">Visit & Move In</h3>
        <p class="small text-muted mb-0">Schedule a visit with the host, confirm the match, and get settled.</p>
      </div>
    </div>
  </div>
</section>