<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h2 class="mb-4">Edit My Profile</h2>

          <% if @user.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= form_with model: @user, url: profile_path, method: :patch do |form| %>
            <div class="mb-3">
              <%= form.label :name, class: "form-label" %>
              <%= form.text_field :name, required: true,
                  class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= form.label :email_address, "Email address",
                  class: "form-label" %>
              <%= form.email_field :email_address, required: true,
                  class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= form.label :phone, "Phone number", class: "form-label" %>
              <%= form.telephone_field :phone, class: "form-control" %>
            </div>

            <div class="mb-4">
              <%= form.label :bio, "Short bio", class: "form-label" %>
              <%= form.text_area :bio, rows: 4, maxlength: 500,
                  class: "form-control",
                  placeholder: "Tell us a little about yourself..." %>
              <div class="form-text">Maximum 500 characters.</div>
            </div>

            <div class="d-flex gap-2">
              <%= form.submit "Save Changes", class: "btn btn-mio" %>
              <%= link_to "Cancel", profile_path,
                  class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>