<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="mb-4">
        <%= link_to "&larr; Back to Applications".html_safe, applications_path, class: "text-decoration-none text-secondary" %>
      </div>
      
      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
          <div class="d-flex justify-content-between align-items-center">
            <h2 class="h3 fw-bold mb-0">Application Details</h2>
            <span class="badge bg-<%= @application.accepted? ? 'success' : (@application.pending? ? 'warning text-dark' : 'secondary') %> fs-6">
              <%= @application.status.capitalize %>
            </span>
          </div>
        </div>
        
        <div class="card-body p-4">
          <div class="row mb-4">
            <div class="col-sm-6 mb-3 mb-sm-0">
              <p class="text-muted small mb-1">Applicant</p>
              <p class="fw-semibold mb-0"><%= @application.seeker.name %></p>
            </div>
            <div class="col-sm-6">
              <p class="text-muted small mb-1">Applied for</p>
              <p class="fw-semibold mb-0">
                <%= link_to @application.listing.title, listing_path(@application.listing), class: "text-decoration-none accent-roomie" %>
              </p>
            </div>
          </div>

          <div class="row mb-4 bg-light p-3 rounded-3">
            <div class="col-sm-6 mb-3 mb-sm-0">
              <p class="text-muted small mb-1">Desired Move-in</p>
              <p class="fw-semibold mb-0"><%= @application.desired_move_in_date.strftime("%B %d, %Y") %></p>
            </div>
            <div class="col-sm-6">
              <p class="text-muted small mb-1">Length of Stay</p>
              <p class="fw-semibold mb-0"><%= @application.length_of_stay_days %> days</p>
            </div>
          </div>

          <div class="mb-4">
            <p class="text-muted small mb-2">Message to Host</p>
            <div class="p-3 border rounded-3 bg-light text-muted">
              "<%= @application.message %>"
            </div>
          </div>

          <% if @application.visits.any? %>
            <hr class="my-4">
            <h4 class="h5 fw-bold mb-3">Scheduled Visits</h4>
            <ul class="list-group list-group-flush">
              <% @application.visits.each do |visit| %>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                  <div>
                    <span class="fw-semibold text-dark"><%= visit.scheduled_at.strftime("%B %d, %Y at %I:%M %p") %></span>
                  </div>
                  <span class="badge bg-light text-dark border"><%= visit.status.capitalize %></span>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>