<main class="container py-5">
  <div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Room <span class="accent-roomie">Applications</span></h1>
    <p class="text-muted">Track the status of all room requests.</p>
  </div>

  <div class="table-responsive bg-white shadow-sm rounded-4 border">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col" class="py-3 px-4">Listing</th>
          <th scope="col" class="py-3">Applicant</th>
          <th scope="col" class="py-3">Move-in Date</th>
          <th scope="col" class="py-3">Status</th>
          <th scope="col" class="py-3 px-4 text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @applications.each do |app| %>
          <tr>
            <td class="px-4 py-3"><%= link_to app.listing.title, listing_path(app.listing), class: "text-decoration-none fw-semibold text-dark" %></td>
            <td class="py-3"><%= app.seeker.name %></td>
            <td class="py-3"><%= app.desired_move_in_date.strftime("%b %d, %Y") %></td>
            <td class="py-3">
              <span class="badge bg-<%= app.accepted? ? 'success' : (app.pending? ? 'warning text-dark' : 'secondary') %>">
                <%= app.status.capitalize %>
              </span>
            </td>
            <td class="px-4 py-3 text-end">
              <%= link_to "View Details", application_path(app), class: "btn btn-sm btn-outline-primary rounded-3" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</main>