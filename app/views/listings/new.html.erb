<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="mb-4">
        <%= link_to "&larr; Back to Property".html_safe, @property, class: "text-decoration-none text-secondary" %>
      </div>
      
      <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">List a <span class="accent-roomie">New Room</span></h1>
        <p class="text-muted">Fill in the details for your space in <%= @property.title %>.</p>
      </div>
      
      <%= render "form", listing: @listing %>
    </div>
  </div>
</main>