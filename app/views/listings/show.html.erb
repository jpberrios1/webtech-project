<main class="container py-5">
  <div class="mb-4 text-start">
    <%= link_to "&larr; Back to Search".html_safe, listings_path, class: "text-decoration-none text-secondary fw-semibold hover-accent" %>
  </div>

  <% if @listing.property.user == current_user || current_user.name.downcase.include?("mod") %>
    <div class="d-flex gap-2 mb-4">
      <%= link_to "Edit Room", edit_listing_path(@listing), class: "btn btn-sm btn-outline-primary rounded-3" %>
      <%= link_to "Delete Room", @listing, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger rounded-3" %>
    </div>
  <% end %>

  <%# NEW: the state of the listing, and the actions available in that state %>
  <p class="mb-2">Status: <span class="badge bg-secondary"><%= @listing.status.humanize %></span></p>

  <% if @listing.hosted_by?(current_user) || current_user.moderator? %>
    <div class="d-flex gap-2 mb-4">
      <% if @listing.draft? %>
        <%= button_to "Publish", listing_path(@listing), method: :patch,
              params: { transition: "publish" },
              class: "btn btn-sm btn-success rounded-3" %>
      <% end %>

      <% if @listing.reserved? %>
        <%= button_to "Mark as Rented", listing_path(@listing), method: :patch,
              params: { transition: "mark_as_rented" },
              class: "btn btn-sm btn-dark rounded-3",
              form: { data: { turbo_confirm: "Has the new housemate moved in?" } } %>
      <% end %>

      <% unless @listing.rented? || @listing.withdrawn? %>
        <%= button_to "Withdraw", listing_path(@listing), method: :patch,
              params: { transition: "withdraw" },
              class: "btn btn-sm btn-outline-danger rounded-3",
              form: { data: { turbo_confirm: "Withdraw this listing? Open applications will be rejected and it can't be published again." } } %>
      <% end %>
    </div>
  <% end %>

  <div class="row g-5">
    <div class="col-md-8">
      <h1 class="display-5"><%= @listing.title %></h1>
      <p class="lead text-muted">
        <%= link_to @listing.property.title, property_path(@listing.property), class: "text-decoration-none accent-roomie" %> in 
        <%= @listing.property.neighborhood&.name %>, <%= @listing.property.neighborhood&.city %>
      </p>
      
      <% if @listing.photos.attached? %>
        <div class="row g-2 mb-4">
          <% @listing.photos.each_with_index do |photo, index| %>
            <div class="<%= index.zero? ? 'col-12' : 'col-6 col-md-4' %>">
              <%= image_tag photo.variant(:large), class: "img-fluid rounded-4 shadow-sm w-100",
                    style: "object-fit: cover; #{index.zero? ? 'max-height: 450px;' : 'height: 150px;'}",
                    alt: "#{@listing.title}, photo #{index + 1}" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="bg-light p-4 rounded-4 mb-4">
        <h3 class="h5 fw-bold mb-3">Description</h3>
        <p class="text-muted"><%= @listing.description %></p>
      </div>

      <div class="row mt-4">
        <div class="col-md-6">
          <h4 class="h6 fw-bold text-uppercase text-secondary">Amenities</h4>
          <ul class="list-group list-group-flush bg-transparent">
            <% @listing.property.amenities.each do |amenity| %>
              <li class="list-group-item bg-transparent text-muted border-0 py-1"><i class="bi bi-check2 text-success me-2"></i><%= amenity.name %></li>
            <% end %>
          </ul>
        </div>
        <div class="col-md-6">
          <h4 class="h6 fw-bold text-uppercase text-secondary">Shared Spaces</h4>
          <ul class="list-group list-group-flush bg-transparent">
            <% @listing.property.shared_spaces.each do |space| %>
              <li class="list-group-item bg-transparent text-muted border-0 py-1"><i class="bi bi-house text-primary me-2"></i><%= space.name %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card shadow-sm border-0 rounded-4 sticky-top" style="top: 20px;">
        <div class="card-body p-4 text-center">
          <h3 class="card-title display-6 accent-roomie">$<%= @listing.monthly_rent %></h3>
          <p class="text-muted mb-4">per month</p>
          
          <ul class="list-group list-group-flush text-start mb-4">
            <li class="list-group-item d-flex justify-content-between px-0"><strong>Deposit:</strong> $<%= @listing.deposit %></li>
            <li class="list-group-item d-flex justify-content-between px-0"><strong>Available:</strong> <%= @listing.available_from.strftime("%b %d, %Y") %></li>
            <li class="list-group-item d-flex justify-content-between px-0"><strong>Minimum stay:</strong> <%= @listing.minimum_stay_days %> days</li>
          </ul>
          
          <% if @listing.property.user != current_user && @listing.status == "published" %>
            <% application = @application || Application.new %>
            <%= form_with model: [@listing, application], class: "row g-3 text-start mt-2" do |f| %>
              
              <!-- Caja de Errores de Validación -->
              <% if application.errors.any? %>
                <div class="col-12">
                  <div class="alert alert-danger py-2 mb-0 rounded-3 small">
                    <ul class="mb-0 ps-3">
                      <% application.errors.full_messages.each do |msg| %>
                        <li><%= msg %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>

              <div class="col-12">
                <%= f.label :message, "Introduction Message", class: "form-label fw-bold small text-muted" %>
                <%= f.text_area :message, rows: 2, class: "form-control border-0", placeholder: "Tell the host about yourself..." %>
              </div>
              <div class="col-6">
                <%= f.label :desired_move_in_date, "Move-in Date", class: "form-label fw-bold small text-muted" %>
                <%= f.date_field :desired_move_in_date, class: "form-control border-0" %>
              </div>
              <div class="col-6">
                <%= f.label :length_of_stay_days, "Stay (Days)", class: "form-label fw-bold small text-muted" %>
                <%= f.number_field :length_of_stay_days, class: "form-control border-0" %>
              </div>
              <div class="col-12 mt-3">
                <%= f.submit "Apply Now", class: "btn btn-mio w-100 py-2 rounded-3" %>
              </div>
            <% end %>
          <% end %>

        </div>
      </div>
    </div>
  </div>

<hr class="my-5">
<h3 class="fw-bold mb-4">Property Reviews</h3>
<% target_property = defined?(@listing) ? @listing.property : @property %>

<% if target_property.reviews.any? %>
  <div class="row g-4">
    <% target_property.reviews.each do |review| %>
      <div class="col-md-6">
        <div class="card border-0 bg-light rounded-4 h-100 p-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold"><%= review.user.name %></span>
            <span class="text-warning">
              <% review.rating.times do %><i class="bi bi-star-fill"></i><% end %>
              <% (5 - review.rating).times do %><i class="bi bi-star"></i><% end %>
            </span>
          </div>
          <p class="text-muted small mb-0">"<%= review.comment %>"</p>
          <span class="text-muted" style="font-size: 0.75rem;"><%= review.created_at.strftime("%B %Y") %></span>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">No reviews yet for this property.</p>
<% end %>

</main>