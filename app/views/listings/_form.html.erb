<%= form_with model: [@property, listing].compact, class: "card shadow-sm border-0 rounded-4 p-4" do |f| %>
  <div class="row g-4 mb-4">
    <!-- Basic Info -->
    <div class="col-md-12">
      <%= f.label :title, class: "form-label fw-bold small text-muted text-uppercase" %>
      <%= f.text_field :title, class: "form-control bg-light border-0 py-2", placeholder: "e.g., Sunny Master Bedroom" %>
    </div>
    
    <div class="col-md-6">
      <%= f.label :monthly_rent, "Monthly Rent ($)", class: "form-label fw-bold small text-muted text-uppercase" %>
      <%= f.number_field :monthly_rent, step: 0.01, class: "form-control bg-light border-0 py-2" %>
    </div>

    <div class="col-md-6">
      <%= f.label :deposit, "Deposit ($)", class: "form-label fw-bold small text-muted text-uppercase" %>
      <%= f.number_field :deposit, step: 0.01, class: "form-control bg-light border-0 py-2" %>
    </div>

    <!-- Dates & Rules -->
    <div class="col-md-6">
      <%= f.label :available_from, class: "form-label fw-bold small text-muted text-uppercase" %>
      <%= f.date_field :available_from, class: "form-control bg-light border-0 py-2" %>
    </div>

    <div class="col-md-6">
      <%= f.label :minimum_stay_days, "Min. Stay (Days)", class: "form-label fw-bold small text-muted text-uppercase" %>
      <%= f.number_field :minimum_stay_days, class: "form-control bg-light border-0 py-2" %>
    </div>

    <!-- Features -->
    <div class="col-md-12">
      <div class="d-flex gap-4 p-3 bg-light rounded-3">
        <div class="form-check form-switch">
          <%= f.check_box :is_furnished, class: "form-check-input" %>
          <%= f.label :is_furnished, "Furnished", class: "form-check-label" %>
        </div>
        <div class="form-check form-switch">
          <%= f.check_box :has_private_bathroom, class: "form-check-input" %>
          <%= f.label :has_private_bathroom, "Private Bathroom", class: "form-check-label" %>
        </div>
      </div>
    </div>

    <!-- Action Text -->
    <div class="col-md-12">
      <%= f.label :description, class: "form-label fw-bold small text-muted text-uppercase" %>
      <div class="bg-light border-0 rounded-3 p-2">
        <%= f.rich_text_area :description, class: "trix-content min-vh-25" %>
      </div>
    </div>

    <div class="col-md-12">
      <%= f.label :house_rules, class: "form-label fw-bold small text-muted text-uppercase" %>
      <div class="bg-light border-0 rounded-3 p-2">
        <%= f.rich_text_area :house_rules, class: "trix-content min-vh-25" %>
      </div>
    </div>

    <!-- Active Storage -->
    <!-- Active Storage -->
    <div class="col-md-12">
      <%= f.label :photos, "Upload Photographs", class: "form-label fw-bold small text-muted text-uppercase" %>

      <%# Photos already saved. Sending a photo set replaces the whole set, so each photo
        # to keep is sent back by its signed id; unchecking one removes it. %>
      <% saved_photos = listing.photos.select(&:persisted?) %>
      <% if saved_photos.any? %>
        <div class="d-flex flex-wrap gap-3 mb-3">
          <% saved_photos.each do |photo| %>
            <label class="text-center small text-muted">
              <%= image_tag photo.variant(:card), class: "rounded-3 d-block mb-1",
                    style: "width: 120px; height: 80px; object-fit: cover;" %>
              <%= check_box_tag "listing[photos][]", photo.signed_id, true,
                    id: "keep_photo_#{photo.id}", class: "form-check-input me-1" %>
              Keep
            </label>
          <% end %>
        </div>
      <% end %>

      <%= f.file_field :photos, multiple: true, accept: Listing::PHOTO_CONTENT_TYPES.join(","),
            class: "form-control bg-light border-0" %>
      <div class="form-text">
        JPEG, PNG or WebP, up to <%= Listing::PHOTO_MAX_SIZE / 1.megabyte %> MB each. You can select several at once.
      </div>
      <% listing.errors[:photos].each do |message| %>
        <div class="text-danger small mt-1"><%= message %></div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-3 mt-2">
    <%= link_to "Cancel", 'javascript:history.back()', class: "btn btn-light px-4 rounded-3" %>
    <%= f.submit class: "btn btn-mio px-5 rounded-3" %>
  </div>
<% end %>