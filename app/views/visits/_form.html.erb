<%= form_with model: visit, class: "card shadow-sm border-0 rounded-4 p-4" do |f| %>
  <div class="mb-4">
    <%= f.label :scheduled_at, "Date & Time", class: "form-label fw-bold small text-muted text-uppercase" %>
    <%= f.datetime_field :scheduled_at, class: "form-control bg-light border-0 py-2" %>
    <% visit.errors[:scheduled_at].each do |message| %>
      <div class="text-danger small mt-1"><%= message %></div>
    <% end %>
    <div class="form-text">Rescheduling cancels this visit and proposes a new one, which the applicant has to confirm again.</div>
  </div>
  <div class="d-flex justify-content-end gap-3 mt-2">
    <%= link_to "Back", application_path(visit.application), class: "btn btn-light px-4 rounded-3" %>
    <%= f.submit "Reschedule Visit", class: "btn btn-mio px-5 rounded-3" %>
  </div>
<% end %>