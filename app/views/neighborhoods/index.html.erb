<main class="container py-5">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-5">
    <div class="text-start">
      <h1 class="display-5 fw-bold text-nowrap">Explore <span class="accent-roomie">Neighborhoods</span></h1>
      <p class="text-muted mt-2">Find the perfect area for your next home.</p>
    </div>
    
    <% if current_user.name.downcase.include?("mod") %>
      <div>
        <%= link_to "Add Neighborhood", new_neighborhood_path, class: "btn btn-mio rounded-3" %>
      </div>
    <% end %>
  </div>

  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @neighborhoods.each do |neighborhood| %>
      <div class="col">
        <div class="card h-100 shadow-sm border-0 bg-light rounded-4">
          <div class="card-body text-center p-4">
            <h5 class="card-title fw-bold"><%= neighborhood.name %></h5>
            <p class="text-muted mb-4"><%= neighborhood.city %></p>
            
            <div class="d-grid gap-2">
              <%= link_to "View Properties", neighborhood_path(neighborhood), class: "btn btn-outline-secondary rounded-3" %>
              
              <% if current_user.name.downcase.include?("mod") %>
                <div class="d-flex justify-content-center gap-2 mt-2">
                  <%= link_to "Edit", edit_neighborhood_path(neighborhood), class: "text-decoration-none small text-primary fw-semibold" %>
                  <span class="text-muted">|</span>
                  <%= link_to "Delete", neighborhood, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-decoration-none small text-danger fw-semibold" %>
                </div>
              <% end %>
            </div>
            
          </div>
        </div>
      </div>
    <% end %>
  </div>
</main>